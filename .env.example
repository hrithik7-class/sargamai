# ─────────────────────────────────────────────────────────────────────────────
# SargamAI Frontend — Environment Variables
# Copy this file to .env and fill in your real credentials.
# Backend-only secrets (DB, Redis, SMTP, JWT signing key) belong in
# sargambackend/.env, not here — the frontend never reads them.
# ─────────────────────────────────────────────────────────────────────────────

# NextAuth — REQUIRED
# Generate a strong secret:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth credentials
# https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
